# Public origin of the site. Used for canonical URLs, Open Graph, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://vybe.crokta.com

# Set to "production" on the live deployment only. Anything else serves a robots.txt that
# disallows indexing, so previews and staging never show up in search.
VYBE_ENV=development

# The platform's gateway. Waitlist sign-ups and partner enquiries go to the admin BFF's intake
# routes under it. Unset: submissions are logged to the server console instead.
VYBE_API_URL=http://localhost:8080

# Presented to the intake routes. Server-side only — never prefix it with NEXT_PUBLIC_.
# Set centrally as VYBE_INTAKE_KEY in the root .env; `./deploy.sh init` writes it here.
VYBE_INTAKE_KEY=

# Google Search Console verification token (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
